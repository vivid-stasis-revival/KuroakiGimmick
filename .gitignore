# Local game resources and derived exports are private.
# Keep application branding available in the source repository.
/Assets/*
!/Assets/App/
!/Assets/tips.json
/GameUI_*/
/GimmickExtras_*/
/RoomFX_*/
/FXExports/
/NoteExports/

# Verbatim decompiled game code kept locally as a reference; not redistributable.

# Game-side mod and sample chart data: this repository is the editor source only.
/Integrations/
/Samples/

# Build outputs and local archives may contain private Assets.
/bin/
/obj/
/dist/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Editor and operating-system files.
.DS_Store
._*
__MACOSX/
.idea/
.vs/
*.user
*.suo
__pycache__/
*.py[cod]

# Local-only test projects and measurement logs.
/tests/

# RustBridge artifacts
/rust/**/target/
/rust/**/Cargo.lock

# Platform output and signing material (never commit keys).
**/bin/
**/obj/
*.jks
*.keystore
*.p12
*.pfx
/platform/mobile/ios/Assets.xcassets/AppIcon.appiconset/icon.png
/platform/switch/native/icon.jpg
/scripts/assets/
