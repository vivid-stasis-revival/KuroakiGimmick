set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(NINTENDO_SWITCH TRUE CACHE BOOL "Horizon/libnx platform")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{DEVKITPRO})
    message(FATAL_ERROR "DEVKITPRO must be set")
endif()
set(CMAKE_C_COMPILER "$ENV{DEVKITPRO}/devkitA64/bin/aarch64-none-elf-gcc")
set(CMAKE_CXX_COMPILER "$ENV{DEVKITPRO}/devkitA64/bin/aarch64-none-elf-g++")
set(CMAKE_AR "$ENV{DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ar")
set(CMAKE_RANLIB "$ENV{DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ranlib")
set(CMAKE_C_FLAGS_INIT "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE -D__SWITCH__ -I$ENV{DEVKITPRO}/libnx/include")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "$ENV{DEVKITPRO}/portlibs/switch" "$ENV{DEVKITPRO}/libnx")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(PKG_CONFIG_EXECUTABLE "$ENV{DEVKITPRO}/portlibs/switch/bin/aarch64-none-elf-pkg-config" CACHE FILEPATH "Switch pkg-config")
