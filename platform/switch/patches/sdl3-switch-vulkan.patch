diff --git a/src/video/switch/SDL_switchvulkan.c b/src/video/switch/SDL_switchvulkan.c
new file mode 100644
index 0000000..47f7cef
--- /dev/null
+++ b/src/video/switch/SDL_switchvulkan.c
@@ -0,0 +1,66 @@
+/* Altered SDL3-Switch source: statically linked Mesa NVK, zlib license. */
+#include "SDL_internal.h"
+#if defined(SDL_VIDEO_DRIVER_SWITCH) && defined(SDL_VIDEO_VULKAN)
+#define VK_USE_PLATFORM_VI_NN
+#include "../SDL_vulkan_internal.h"
+#include "SDL_switchvulkan.h"
+#include <switch.h>
+
+/* The Mesa Switch SDK exports this directly: no dlopen, loader, or ICD. */
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance instance, const char *name);
+
+bool SWITCH_Vulkan_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    if (path && *path) return SDL_SetError("Switch Vulkan is statically linked; custom loader paths are unsupported");
+    PFN_vkEnumerateInstanceExtensionProperties enumerate =
+        (PFN_vkEnumerateInstanceExtensionProperties)vkGetInstanceProcAddr(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+    if (!enumerate) return SDL_SetError("Mesa NVK extension enumeration is unavailable");
+    Uint32 count = 0;
+    VkExtensionProperties *extensions = SDL_Vulkan_CreateInstanceExtensionsList(enumerate, &count);
+    if (!extensions) return false;
+    bool surface = false, vi = false;
+    for (Uint32 i = 0; i < count; i++) {
+        if (!SDL_strcmp(extensions[i].extensionName, VK_KHR_SURFACE_EXTENSION_NAME)) surface = true;
+        if (!SDL_strcmp(extensions[i].extensionName, VK_NN_VI_SURFACE_EXTENSION_NAME)) vi = true;
+    }
+    SDL_free(extensions);
+    if (!surface || !vi) return SDL_SetError("Mesa NVK requires VK_KHR_surface and VK_NN_vi_surface");
+    _this->vulkan_config.vkGetInstanceProcAddr = (SDL_FunctionPointer)vkGetInstanceProcAddr;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties = (SDL_FunctionPointer)enumerate;
+    _this->vulkan_config.loader_handle = NULL;
+    _this->vulkan_config.loader_path[0] = '\0';
+    return true;
+}
+
+void SWITCH_Vulkan_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    _this->vulkan_config.vkGetInstanceProcAddr = NULL;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties = NULL;
+}
+
+char const *const *SWITCH_Vulkan_GetInstanceExtensions(SDL_VideoDevice *_this, Uint32 *count)
+{
+    static const char *const extensions[] = {VK_KHR_SURFACE_EXTENSION_NAME, VK_NN_VI_SURFACE_EXTENSION_NAME};
+    if (count) *count = SDL_arraysize(extensions);
+    return extensions;
+}
+
+bool SWITCH_Vulkan_CreateSurface(SDL_VideoDevice *_this, SDL_Window *window, VkInstance instance,
+                                 const struct VkAllocationCallbacks *allocator, VkSurfaceKHR *surface)
+{
+    PFN_vkCreateViSurfaceNN create = (PFN_vkCreateViSurfaceNN)vkGetInstanceProcAddr(instance, "vkCreateViSurfaceNN");
+    if (!create) return SDL_SetError("vkCreateViSurfaceNN not found");
+    VkViSurfaceCreateInfoNN info = {0};
+    info.sType = VK_STRUCTURE_TYPE_VI_SURFACE_CREATE_INFO_NN;
+    /* mesa-switch's VI WSI interprets this as NWindow*, not a raw VI layer. */
+    info.window = nwindowGetDefault();
+    VkResult result = create(instance, &info, allocator, surface);
+    return result == VK_SUCCESS || SDL_SetError("vkCreateViSurfaceNN failed: %s", SDL_Vulkan_GetResultString(result));
+}
+
+void SWITCH_Vulkan_DestroySurface(SDL_VideoDevice *_this, VkInstance instance, VkSurfaceKHR surface,
+                                  const struct VkAllocationCallbacks *allocator)
+{
+    SDL_Vulkan_DestroySurface_Internal((void *)vkGetInstanceProcAddr, instance, surface, allocator);
+}
+#endif
