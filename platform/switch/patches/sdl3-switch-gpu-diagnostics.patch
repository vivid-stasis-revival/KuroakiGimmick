 #define DESCRIPTOR_POOL_SIZE          128
 #define WINDOW_PROPERTY_DATA          "SDL_GPUVulkanWindowPropertyData"
@@ -1258,6 +1264,7 @@ static inline const char *VkErrorMessages(VkResult code)
     switch (code) {
         ERR_TO_STR(VK_ERROR_OUT_OF_HOST_MEMORY)
         ERR_TO_STR(VK_ERROR_OUT_OF_DEVICE_MEMORY)
+        ERR_TO_STR(VK_ERROR_MEMORY_MAP_FAILED)
         ERR_TO_STR(VK_ERROR_FRAGMENTED_POOL)
         ERR_TO_STR(VK_ERROR_OUT_OF_POOL_MEMORY)
         ERR_TO_STR(VK_ERROR_INITIALIZATION_FAILED)
@@ -1868,8 +1875,14 @@ static Uint8 VULKAN_INTERNAL_AllocateMemory(
         &allocation->memory);
 
     if (result != VK_SUCCESS) {
+        SDL_SetError("vkAllocateMemory failed: %s (bytes=%llu, memoryType=%u, flags=0x%x)",
+                     VkErrorMessages(result), (unsigned long long)allocationSize,
+                     memoryTypeIndex, renderer->memoryProperties.memoryTypes[memoryTypeIndex].propertyFlags);
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "%s", SDL_GetError());
         // Uh oh, we couldn't allocate, time to clean up
         SDL_free(allocation->freeRegions);
+        SDL_free(allocation->usedRegions);
+        SDL_DestroyMutex(allocation->memoryLock);
 
         allocator->allocationCount -= 1;
         allocator->allocations = SDL_realloc(
@@ -1890,7 +1903,20 @@ static Uint8 VULKAN_INTERNAL_AllocateMemory(
