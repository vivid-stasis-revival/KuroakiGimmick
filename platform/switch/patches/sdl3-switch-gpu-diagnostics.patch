+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "%s", SDL_GetError());
+        for (i = 0; i < renderer->memoryProperties.memoryTypeCount; i += 1) {
+            SDL_LogError(SDL_LOG_CATEGORY_GPU, "Vulkan memory type %u: flags=0x%x heap=%u", i,
