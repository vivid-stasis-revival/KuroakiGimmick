 #include <switch.h>
 
 #include <unistd.h>
@@ -138,6 +139,8 @@ static ssize_t udp_log_write(struct _reent *r, void *fd, const char *ptr, size_t
 }
 
 static FILE* file_log_handle;
+static int nxlink_log_socket = -1;
+void io_set_nxlink_socket(int socket_fd) { nxlink_log_socket = socket_fd; }
 static ssize_t file_log_write(struct _reent *r, void *fd, const char *ptr, size_t len)
 {
     if (!file_log_handle)
@@ -146,7 +149,16 @@ static ssize_t file_log_write(struct _reent *r, void *fd, const char *ptr, size_
     if (len == 0)
         return 0;
 
-    return fwrite(ptr, 1, len, file_log_handle);
+    size_t written = fwrite(ptr, 1, len, file_log_handle);
+    if (nxlink_log_socket >= 0) {
+        // A disconnected or slow log collector must not stall rendering/audio.
+        ssize_t sent = send(nxlink_log_socket, ptr, len, MSG_DONTWAIT);
+        if (sent < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+            close(nxlink_log_socket);
+            nxlink_log_socket = -1;
+        }
+    }
+    return written;
 }
 
 static int redirect_newlib_io(newlib_io_write_callback callback)
@@ -185,6 +197,10 @@ int io_stdio_to_svc()
 
 void io_stdio_finish()
 {
+    if (nxlink_log_socket >= 0) {
+        close(nxlink_log_socket);
