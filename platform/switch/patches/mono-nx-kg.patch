     #if defined(DLSHIM_SDL2)
 	CHECK_LIB_NAME(name, SDL2);
@@ -107,6 +116,10 @@ void *dlshim_getSymbol(void *handle, const char *name, char **err, void *user_da
 		CHECK_LIB_SYMBOL(SystemNative)
 		CHECK_LIB_SYMBOL(GlobalizationNative)
 		CHECK_LIB_SYMBOL(CompressionNative)
+#if defined(DLSHIM_KG)
+        CHECK_LIB_SYMBOL(SDL3)
+        CHECK_LIB_SYMBOL(KGSwitch)
+#endif
 
 	#if defined(DLSHIM_SDL2)
 		CHECK_LIB_SYMBOL(SDL2)
diff --git a/native/shared/heap.c b/native/shared/heap.c
index 506f5bc..5fd2ba0 100644
--- a/native/shared/heap.c
+++ b/native/shared/heap.c
@@ -49,6 +49,13 @@ void __libnx_initheap(void)
 	// Give libnx half the heap and mono the other half, Align the mono side to 4MB because we know that's the biggest granularity it needs.
     // TODO: Consider a better split for this. In practice it's compilcated because mono might allocate internal data structures via malloc, any mesa/opengl allocations are also handled by libnx.
 	size_t newlib_size = size / 2;
+#if defined(DLSHIM_KG)
+    // K/G's Mesa/NVK resources share malloc with Mono's native structures.
+    // Keep up to 1 GiB for the interpreter's fake mmap heap, give the rest to malloc.
+    size_t mono_size = size / 2;
+    if (mono_size > 1024ULL * 1024 * 1024) mono_size = 1024ULL * 1024 * 1024;
+    newlib_size = size - mono_size;
+#endif
 	mono_heap_start = (((intptr_t)addr + newlib_size) + (0x400000 - 1)) & ~(0x400000 - 1);
 	mono_heap_end   = (intptr_t)addr + size;
 
@@ -64,4 +71,4 @@ void __libnx_initheap(void)
 
     // Note that even tho we set the pointers newlib's heap is still not ready cause libnx hasn't called the thread init function yet. We can't use malloc yet.
 	mono_nx_fakemmap_init(mono_heap_start, mono_heap_end);
-}
\ No newline at end of file
+}
