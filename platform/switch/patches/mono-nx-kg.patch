 REGISTER_LIBRARY(GlobalizationNative, "libSystem.Globalization.Native", 0x04)
 REGISTER_LIBRARY(CompressionNative, "libSystem.IO.Compression.Native", 0x05)
 
+#if defined(DLSHIM_KG)
