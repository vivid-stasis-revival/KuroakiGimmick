diff --git a/native/interpreter/Makefile b/native/interpreter/Makefile
index 4a85fea..73ed655 100644
--- a/native/interpreter/Makefile
+++ b/native/interpreter/Makefile
@@ -45,8 +45,8 @@ include $(DEVKITPRO)/libnx/switch_rules
 #   of a homebrew executable (.nro). This is intended to be used for sysmodules.
 #   NACP building is skipped as well.
 #---------------------------------------------------------------------------------
-MONO_NX_USE_CIMGUI 			:=  	1
-MONO_NX_USE_SDL2 			:=  	1
+MONO_NX_USE_CIMGUI 			?=  	1
+MONO_NX_USE_SDL2 			?=  	1
 MONO_NX_USE_OPENGL	 		:=  	0
 MONO_NX_USE_OPENAL	 		:=  	0
 
@@ -139,6 +139,26 @@ ifeq ($(MONO_NX_USE_OPENAL),1)
 	LIBS		+=	`$(PREFIX)pkg-config --libs openal sdl2`
 endif
 
+ifneq ($(strip $(KG_SWITCH_NATIVE)),)
+    # Dedicated entry point replaces source/main.c; shared Mono core remains upstream.
+    SOURCES := $(KG_SWITCH_NATIVE) ../shared ../shared/third_party/ini
+    KG_PKG_CONFIG ?= pkg-config
+    CFLAGS += -DDLSHIM_KG=1 `$(KG_PKG_CONFIG) --cflags sdl3 vulkan`
+    LDFLAGS += -Wl,--wrap=SystemNative_Malloc -Wl,--wrap=SystemNative_Rename
+    APP_TITLE := Kuroaki/Gimmick (experimental)
+    APP_AUTHOR := vivid-stasis-revival
+    APP_VERSION := 0.1.4
+    LIBS += -Wl,--start-group `$(KG_PKG_CONFIG) --static --libs sdl3 vulkan` -Wl,--end-group
+    ifneq ($(strip $(KG_SWITCH_AOT)),)
+        KG_SWITCH_AOT_NXLINK ?= 0
+        CFLAGS += -DKG_SWITCH_AOT=1 -DKG_SWITCH_AOT_NXLINK=$(KG_SWITCH_AOT_NXLINK) -I$(KG_SWITCH_AOT)
+        LIBS := $(wildcard $(KG_SWITCH_AOT)/objects/*.o) $(subst libmono-component-debugger-static.a,libmono-component-debugger-stub-static.a,$(LIBS))
+        ROMFS := $(KG_SWITCH_AOT)/romfs
+        APP_TITLE := Kuroaki/Gimmick (Mono Full AOT)
+        APP_VERSION := 0.1.4-r5-aot
+    endif
+endif
+
 # These need to be at the end
 LIBS	+=	-lnx -lm -lstdc++
 
@@ -152,7 +172,7 @@ ifneq ($(BUILD),$(notdir $(CURDIR)))
 export OUTPUT	:=	$(CURDIR)/$(TARGET)
 export TOPDIR	:=	$(CURDIR)
 
-export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
+export VPATH	:=	$(foreach dir,$(SOURCES),$(if $(filter /%,$(dir)),$(dir),$(CURDIR)/$(dir))) \
 			$(foreach dir,$(DATA),$(CURDIR)/$(dir))
 
 export DEPSDIR	:=	$(CURDIR)/$(BUILD)
@@ -210,7 +230,7 @@ ifeq ($(strip $(ICON)),)
 		endif
 	endif
 else
-	export APP_ICON := $(TOPDIR)/$(ICON)
+	export APP_ICON := $(if $(filter /%,$(ICON)),$(ICON),$(TOPDIR)/$(ICON))
 endif
 
 ifeq ($(strip $(NO_ICON)),)
@@ -226,7 +246,7 @@ ifneq ($(APP_TITLEID),)
 endif
 
 ifneq ($(ROMFS),)
-	export NROFLAGS += --romfsdir=$(CURDIR)/$(ROMFS)
+	export NROFLAGS += --romfsdir=$(if $(filter /%,$(ROMFS)),$(ROMFS),$(CURDIR)/$(ROMFS))
 endif
 
 .PHONY: $(BUILD) clean all
