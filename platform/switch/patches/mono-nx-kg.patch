     if (logUdpSocket >= 0)
     {
         close(logUdpSocket);
@@ -228,6 +244,8 @@ int io_stdio_to_file(const char* filename)
     if (!file_log_handle)
         return -1;
 
+    /* Preserve complete diagnostic lines if Mono aborts without normal cleanup. */
+    setvbuf(file_log_handle, NULL, _IOLBF, 0);
     fprintf(file_log_handle, "--- starting log ---\n");
 
     if (redirect_newlib_io(file_log_write) < 0)
@@ -263,4 +281,4 @@ char* io_strdup(const char* str)
     strcpy(res, str);
 
     return res;
-}
\ No newline at end of file
