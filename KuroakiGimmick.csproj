<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.175</FileVersion>
    <InformationalVersion>0.1.4+17.5</InformationalVersion>
    <AssemblyName>KuroakiGimmick</AssemblyName>
    <RootNamespace>KuroakiGimmick</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets/App/Kuroaki.ico')">Assets/App/Kuroaki.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**</DefaultItemExcludes>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs;tests/SelfTests/**/*.cs" />
    <EmbeddedResource Include="src/UI/Localization/*.json" LogicalName="KuroakiGimmick.Localization.%(Filename)%(Extension)" />
    <!-- 界面字体是真正的字体文件，运行时按目标像素密度栅格化；加文案不需要重新生成任何资源。 -->
    <EmbeddedResource Include="Resources/Fonts/*.ttf" LogicalName="KuroakiGimmick.Fonts.%(Filename)%(Extension)" />
    <!-- Embed the SAME editable definitions, so an older external Assets directory
         cannot remove the extension-ID table from a newer executable. -->
    <!-- Assets/ holds art exported from a local game install and is not in the
         source repository, so every reference to it is guarded by Exists(): a
         clone without Assets/ still compiles. With Assets/ present nothing changes. -->
    <EmbeddedResource Include="Assets/Gimmicks/*/manifest.json" />
    <EmbeddedResource Include="Assets/Documentation/vsm-reference.json" LogicalName="KuroakiGimmick.VsmReference.json" Condition="Exists('Assets/Documentation/vsm-reference.json')" />
    <EmbeddedResource Include="tests/Fixtures/r15-scarlet-definition.json" LogicalName="KuroakiGimmick.Tests.LegacyScarletDefinition.json" />
    <EmbeddedResource Include="Assets/Catalog/legacy-per-frame-bindings.json" LogicalName="KuroakiGimmick.LegacyPerFrameBindings.json" Condition="Exists('Assets/Catalog/legacy-per-frame-bindings.json')" />
    <EmbeddedResource Include="Assets/Catalog/jackets.json" LogicalName="KuroakiGimmick.JacketCatalog.json" Condition="Exists('Assets/Catalog/jackets.json')" />
    <EmbeddedResource Include="Assets/Catalog/room-associations.json" LogicalName="KuroakiGimmick.RoomAssociations.json" Condition="Exists('Assets/Catalog/room-associations.json')" />

  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets/**/*;Samples/**/*;Integrations/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="ThirdParty/IBM-Plex-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Assets/Gimmicks/*/manifest.json;Assets/Catalog/*.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="docs\media\" />
  </ItemGroup>
</Project>
